generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VotingMode {
  PODIUM
  SWIPE
  COINS
}

model EventConfig {
  id         String     @id @default("default")
  votingMode VotingMode @default(PODIUM)
  coinBudget Int        @default(10)
  swipeDuels Int        @default(12)
  updatedAt  DateTime   @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Vehicle {
  id            String     @id @default(cuid())
  name          String
  number        Int?
  imageUrl      String?
  description   String?
  instagramUrl  String?
  tiktokUrl     String?
  youtubeUrl    String?
  websiteUrl    String?
  active        Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  picks     VotePick[]

  @@index([active])
  @@index([number])
}

model Vote {
  id              String     @id @default(cuid())
  deviceToken     String     @unique
  fingerprintHash String     @unique
  ipHash          String?
  userAgent       String?
  createdAt       DateTime   @default(now())
  picks           VotePick[]

  @@index([ipHash])
}

model VotePick {
  id        String  @id @default(cuid())
  voteId    String
  vehicleId String
  rank      Int
  points    Int
  vote      Vote    @relation(fields: [voteId], references: [id], onDelete: Cascade)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([voteId, vehicleId])
  @@index([vehicleId])
}
