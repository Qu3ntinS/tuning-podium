{
  "name": "@tuning-podium/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun run typecheck",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy && prisma generate",
    "prisma:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.4.4",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/static": "^1.4.10",
    "@prisma/client": "^6.5.0",
    "elysia": "^1.4.28",
    "prisma": "^6.5.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "latest",
    "typescript": "^5.8.2"
  },
  "engines": {
    "bun": ">=1.2"
  }
}
