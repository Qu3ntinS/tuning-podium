# Docker Compose (Profil prod) — kopieren nach .env und anpassen
# Start: docker compose --profile prod up -d --build

POSTGRES_PASSWORD=change-me-strong-db-password

# Öffentliche URL (QR-Codes, CORS) — ohne trailing slash
PUBLIC_APP_URL=https://podium.example.com

HTTP_PORT=8080

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=12h
ADMIN_EMAIL=admin@tuning-podium.local
ADMIN_PASSWORD=change-me-now-123

TRUST_PROXY=true

MAX_UPLOAD_BYTES=5242880
VOTE_RATE_LIMIT_MAX=5
VOTE_RATE_LIMIT_WINDOW_MS=86400000
