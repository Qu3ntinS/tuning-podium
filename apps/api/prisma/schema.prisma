generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VotingMode {
  PODIUM
  SWIPE
  COINS
  DUEL
}

model Event {
  id         String     @id @default(cuid())
  slug       String     @unique
  name       String
  votingMode VotingMode @default(PODIUM)
  coinBudget Int        @default(10)
  swipeDuels Int        @default(12)
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  vehicles   Vehicle[]
  votes      Vote[]

  @@index([active])
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Vehicle {
  id            String         @id @default(cuid())
  eventId       String
  name          String
  number        Int?
  imageUrl      String?
  description   String?
  instagramUrl  String?
  tiktokUrl     String?
  youtubeUrl    String?
  websiteUrl    String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  picks         VotePick[]
  images        VehicleImage[]

  @@index([eventId])
  @@index([eventId, active])
  @@index([number])
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  url       String
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([vehicleId, sortOrder])
}

model Vote {
  id              String     @id @default(cuid())
  eventId         String
  deviceToken     String
  fingerprintHash String
  ipHash          String?
  userAgent       String?
  createdAt       DateTime   @default(now())
  event           Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  picks           VotePick[]

  @@unique([eventId, deviceToken])
  @@unique([eventId, fingerprintHash])
  @@index([eventId])
  @@index([ipHash])
}

model VotePick {
  id        String  @id @default(cuid())
  voteId    String
  vehicleId String
  rank      Int
  points    Int
  vote      Vote    @relation(fields: [voteId], references: [id], onDelete: Cascade)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([voteId, vehicleId])
  @@index([vehicleId])
}
