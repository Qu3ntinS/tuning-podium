{
  "name": "tuning-podium",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:api": "bun run --filter @tuning-podium/api dev",
    "dev:web": "bun run --filter @tuning-podium/web dev",
    "build": "bun run --filter '*' build",
    "check": "bun run --filter '*' check",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "bun run --filter @tuning-podium/api prisma:migrate",
    "db:studio": "bun run --filter @tuning-podium/api prisma:studio"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.2"
  }
}
