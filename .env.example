# API (apps/api)
DATABASE_URL=postgresql://podium:podium@localhost:5433/tuning_podium
PORT=3001
NODE_ENV=development
TRUST_PROXY=false
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=12h
ADMIN_EMAIL=admin@tuning-podium.local
ADMIN_PASSWORD=change-me-now-123

# Uploads
UPLOAD_DIR=./data/uploads
PUBLIC_ASSETS_PATH=/assets
MAX_UPLOAD_BYTES=5242880

# Rate limits
VOTE_RATE_LIMIT_MAX=5
VOTE_RATE_LIMIT_WINDOW_MS=86400000

# Web (apps/web)
VITE_API_URL=
VITE_PUBLIC_APP_URL=http://localhost:5173
